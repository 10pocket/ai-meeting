# systemd --user の unit。~/.config/systemd/user/ から symlink して使う (README を見よ)。
[Unit]
Description=ai-meeting
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/10pocket/ai-meeting
ExecStart=/usr/bin/docker compose up --build
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
